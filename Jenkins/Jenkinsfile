pipeline {
  agent any

  tools {
    nodejs 'nodejs'
  }

  parameters {
    string(name: 'IMAGE_REPOSITORY', defaultValue: 'ghcr.io/hacrex/secure-ott-streaming-platform', description: 'Container repository to publish when PUBLISH_IMAGE is enabled')
    string(name: 'IMAGE_TAG', defaultValue: '', description: 'Optional immutable image tag; defaults to the Jenkins build number')
    booleanParam(name: 'PUBLISH_IMAGE', defaultValue: false, description: 'Push the image only after validation succeeds')
    booleanParam(name: 'DEPLOY', defaultValue: false, description: 'Deploy only after an approved change window')
  }

  environment {
    IMAGE_TAG = "${params.IMAGE_TAG ?: env.BUILD_NUMBER}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Application build') {
      steps {
        dir('Application-Code') {
          sh 'corepack enable'
          sh 'yarn install --frozen-lockfile'
          sh 'yarn build'
        }
      }
    }

    stage('Terraform validation') {
      steps {
        dir('Terraform') {
          sh 'terraform fmt -check -recursive'
          sh 'terraform init -backend=false'
          sh 'terraform validate'
        }
      }
    }

    stage('Kubernetes manifest validation') {
      steps {
        sh 'kubectl apply --dry-run=client -f Kubernetes/'
      }
    }

    stage('Filesystem security scan') {
      steps {
        sh 'trivy fs --scanners vuln,secret --severity HIGH,CRITICAL --exit-code 1 --no-progress Application-Code'
      }
    }

    stage('Build container image') {
      steps {
        dir('Application-Code') {
          script {
            env.IMAGE_REF = "${params.IMAGE_REPOSITORY}:${env.IMAGE_TAG}"
          }
          sh 'docker build -t "$IMAGE_REF" .'
        }
      }
    }

    stage('Image security scan') {
      steps {
        sh 'trivy image --severity HIGH,CRITICAL --exit-code 1 --no-progress "$IMAGE_REF"'
      }
    }

    stage('Publish image') {
      when {
        expression { params.PUBLISH_IMAGE }
      }
      steps {
        withDockerRegistry(credentialsId: 'container-registry', toolName: 'docker') {
          sh 'docker push "$IMAGE_REF"'
        }
      }
    }

    stage('Deploy to Kubernetes') {
      when {
        expression { params.DEPLOY }
      }
      steps {
        script {
          if (!params.PUBLISH_IMAGE) {
            error('DEPLOY requires PUBLISH_IMAGE so the deployment references a published immutable image.')
          }
        }
        withKubeConfig(credentialsId: 'k8s') {
          sh 'kubectl apply -f Kubernetes/'
          sh 'kubectl set image deployment/netflix-app netflix-app="$IMAGE_REF"'
          sh 'kubectl annotate deployment/netflix-app hacrex.io/release="$IMAGE_REF" --overwrite'
          sh './scripts/smoke-test.sh'
        }
      }
    }
  }
}
